# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1, OPENAI_API_KEY=<openrouter key>,
# model names with the provider prefix (openai/gpt-5.4, openai/gpt-5-nano, openai/text-embedding-3-large)
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
SUMMARY_MODEL_NAME=
EMBEDDING_MODEL=

QDRANT_HOST=
QDRANT_API_KEY=
QDRANT_PORT=
QDRANT_GRPC_PORT=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=

# Spending limits in USD. Empty = default: 20 per month overall, the others off
LIMIT_GLOBAL_USD_PER_MONTH=
LIMIT_USER_USD_PER_WEEK=
LIMIT_USER_RUNS_PER_HOUR=

# The shop: answers may only link to these domains (JSON list); product feed in Google Merchant XML
ALLOWED_LINK_DOMAINS=["myshop.cz"]
CATALOG_FEED_URL=
CATALOG_SYNC_TZ=
