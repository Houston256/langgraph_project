# Generate a .env with new secrets from this file: scripts/new-env.sh .env.example .env

# OpenAI-compatible API. For OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and model
# names with the provider prefix (openai/gpt-5-nano, openai/text-embedding-3-large)
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
SUMMARY_MODEL_NAME=
EMBEDDING_MODEL=

# Filled by new-env.sh
POSTGRES_PASSWORD=
QDRANT_API_KEY=

# The shop: answers may only link to these domains (JSON list); product feed in Google Merchant XML
ALLOWED_LINK_DOMAINS=["myshop.cz"]
CATALOG_FEED_URL=
CATALOG_SYNC_TZ=

# Who a user is: a header the proxy sets, e.g. Cf-Access-Authenticated-User-Email behind
# Cloudflare Access. Leave empty when the chat is public: then each browser gets a visitor cookie
IDENTITY_HEADER=

# Spending limits in USD. Empty = default: 20 per month overall, the others off
LIMIT_GLOBAL_USD_PER_MONTH=
LIMIT_USER_USD_PER_WEEK=
LIMIT_USER_RUNS_PER_HOUR=
